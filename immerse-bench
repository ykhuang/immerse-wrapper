def _plan(config: EffectiveConfig, cases: list[BenchmarkCase]) -> dict[str, Any]:
    target_count = 2 if config.target == "compare" else 1
    calls = len(config.backends) * target_count * (config.warmup + config.runs)
    return {
        "quota_consuming_calls": calls,
        "backend_count": len(config.backends),
        "target_count": target_count,
        "warmup_calls": len(config.backends) * target_count * config.warmup,
        "measured_calls": len(config.backends) * target_count * config.runs,
        "case_ids": [case.id for case in cases],
    }


async def _execute(
    args: argparse.Namespace,
    config: EffectiveConfig,
    cases: list[BenchmarkCase],
    preflight: dict[str, Any],
    samples: list[Sample],
    handshakes: dict[str, float],
) -> None:
    with tempfile.TemporaryDirectory(prefix="immerse-bench-") as temporary:
        root = Path(temporary)
        for backend in config.backends:
            backend_samples, handshake = await _run_backend_group(
                args=args,
                config=config,
                backend=backend,
                cases=cases,
                preflight=preflight,
                temp_root=root,
            )
            samples.extend(backend_samples)
            if handshake is not None:
                handshakes[backend] = round(handshake, 3)
            if args.fail_fast and any(not sample.success for sample in backend_samples):
                break


def _render_text(report: dict[str, Any]) -> str:
    config = report["effective_config"]
    plan = report["plan"]
    lines = [
        f"{BENCHMARK_NAME} schema={SCHEMA_VERSION} status={report['status']}",
        f"env_file={config['env_file'] or 'none'}",
        f"target={config['target']} backends={','.join(config['backends'])} "
        f"runs={config['runs']} warmup={config['warmup']} concurrency={config['concurrency']}",
        f"workload={config['workload']} prompt_profile={config['prompt_profile']} "
        f"quota_calls={plan['quota_consuming_calls']}",
        "",
        "backend      target  ok/total  p50_ms    p95_ms    mean_ms   cv",
    ]
    for item in report["summaries"]:
        duration = item["duration_ms"]
        lines.append(
            f"{item['backend']:<12} {item['target']:<7} "
            f"{item['succeeded']:>2}/{item['attempted']:<5} "
            f"{_display_number(duration['p50']):>9} "
            f"{_display_number(duration['p95']):>9} "
            f"{_display_number(duration['mean']):>9} "
            f"{_display_number(duration['cv']):>8}"
        )
    if report["comparisons"]:
        lines.extend(["", "paired comparison (observational):"])
        for item in report["comparisons"]:
            lines.append(
                f"  {item['backend']}: pairs={item['paired_samples']} "
                f"p50_api_minus_cli_ms={_display_number(item['api_minus_cli_ms']['p50'])} "
                f"p95_ratio={_display_number(item['api_over_cli_ratio']['p95'])}"
            )
    if report["observations"]:
        lines.extend(["", "observations:"])
        for item in report["observations"]:
            lines.append(f"  - {item['backend']} {item['code']}: {item['message']}")
    request_ids = [sample["request_id"] for sample in report["samples"] if sample["request_id"]]
    if request_ids:
        lines.extend(
            [
                "",
                "Correlate API request IDs with response_sent, process_completed, "
                "micro_batch_completed, or codex_app_server_turn_completed logs.",
            ]
        )
    return "\n".join(lines) + "\n"


def _display_number(value: object) -> str:
    if value is None:
        return "-"
    if isinstance(value, float):
        return f"{value:.3f}"
    return str(value)


def _render(report: dict[str, Any], output_format: str) -> str:
    if output_format == "text":
        return _render_text(report)
    if output_format == "json":
        return json.dumps(report, ensure_ascii=False, sort_keys=True, indent=2) + "\n"
    events: list[dict[str, Any]] = [
        {
            "event": "metadata",
            "schema_version": report["schema_version"],
            "benchmark": report["benchmark"],
            "started_at": report["started_at"],
            "effective_config": report["effective_config"],
            "preflight": report["preflight"],
            "plan": report["plan"],
        }
    ]
    events.extend({"event": "sample", "sample": sample} for sample in report["samples"])
    events.extend({"event": "summary", "summary": item} for item in report["summaries"])
    events.extend({"event": "comparison", "comparison": item} for item in report["comparisons"])
    events.append(
        {
            "event": "result",
            "status": report["status"],
            "duration_ms": report["duration_ms"],
            "observations": report["observations"],
        }
    )
    return "".join(
        json.dumps(event, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n"
        for event in events
    )


def _write_output(path_text: str, content: str, *, force: bool) -> None:
    path = Path(path_text).expanduser()
    parent = path.parent.resolve()
    if not parent.is_dir():
        raise ConfigurationError(f"output parent directory does not exist: {parent}")
    path = parent / path.name
    if path.exists() and not force:
        raise ConfigurationError(f"output file exists; use --force: {path}")
    temporary = parent / f".{path.name}.{uuid.uuid4().hex}.tmp"
    try:
        temporary.write_text(content, encoding="utf-8")
        os.replace(temporary, path)
    finally:
        if temporary.exists():
            temporary.unlink()


def _validate_output_destination(path_text: str | None, *, force: bool) -> None:
    if path_text is None:
        return
    path = Path(path_text).expanduser()
    try:
        parent = path.parent.resolve(strict=True)
    except OSError as exc:
        raise ConfigurationError(
            f"output parent directory does not exist: {path.parent}"
        ) from exc
    if not parent.is_dir():
        raise ConfigurationError(f"output parent is not a directory: {parent}")
    resolved = parent / path.name
    if resolved.exists() and not force:
        raise ConfigurationError(f"output file exists; use --force: {resolved}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=BENCHMARK_NAME,
        description=(
            "Compare direct Agy/Codex translation latency with the running "
            "ImmerseWrapper HTTP API. This command consumes model quota."
        ),
    )
    parser.add_argument("--target", choices=("cli", "api", "compare"), default="compare")
    parser.add_argument("--backend", choices=("antigravity", "codex", "all"))
    env_group = parser.add_mutually_exclusive_group()
    env_group.add_argument("--env-file")
    env_group.add_argument("--no-env-file", action="store_true")
    parser.add_argument("--base-url")
    parser.add_argument("--allow-remote-api", action="store_true")
    parser.add_argument("--allow-mock-api", action="store_true")
    parser.add_argument("--runs", type=int, default=10)
    parser.add_argument("--warmup", type=int, default=1)
    parser.add_argument("--concurrency", type=int)
    parser.add_argument("--timeout-seconds", type=float)
    parser.add_argument("--cooldown-ms", type=int, default=0)
    parser.add_argument("--workload", choices=("short", "medium", "long", "mixed"), default="short")
    parser.add_argument("--prompt-profile", choices=("immersive", "minimal"), default="immersive")
    input_group = parser.add_mutually_exclusive_group()
    input_group.add_argument("--text")
    input_group.add_argument("--input-file")
    parser.add_argument("--order", choices=("alternate", "cli-first", "api-first", "random"), default="alternate")
    parser.add_argument("--seed", type=int, default=DEFAULT_SEED)
    parser.add_argument("--format", choices=("text", "json", "jsonl"), default="text")
    parser.add_argument("--output")
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--include-source", action="store_true")
    parser.add_argument("--include-translation", action="store_true")
    parser.add_argument("--fail-fast", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--verbose", action="store_true")
    parser.add_argument("--command")
    parser.add_argument("--model")
    parser.add_argument("--reasoning-effort")
    parser.add_argument("--antigravity-command")
    parser.add_argument("--antigravity-model")
    parser.add_argument("--antigravity-reasoning-effort", choices=("low", "medium", "high"))
    parser.add_argument("--codex-command")
    parser.add_argument("--codex-model")
    parser.add_argument("--codex-reasoning-effort", choices=("minimal", "low", "medium", "high", "xhigh"))
    parser.add_argument("--codex-transport", choices=("exec", "app-server"))
    parser.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    return parser


def _build_report(
    *,
    args: argparse.Namespace,
    config: EffectiveConfig,
    preflight: dict[str, Any],
    plan: dict[str, Any],
    started_at: str,
    started: float,
    samples: list[Sample],
    handshakes: dict[str, float],
    dry_run: bool,
    status_override: str | None = None,
) -> dict[str, Any]:
    sample_dicts = [asdict(sample) for sample in samples]
    summaries = _summaries(samples)
    comparisons = _comparisons(samples)
    failed = any(not sample.success for sample in samples)
    return {
        "schema_version": SCHEMA_VERSION,
        "benchmark": BENCHMARK_NAME,
        "benchmark_version": __version__,
        "started_at": started_at,
        "duration_ms": round((time.perf_counter() - started) * 1000, 3),
        "effective_config": _config_report(args, config),
        "preflight": {**preflight, "app_server_handshake_ms": handshakes},
        "plan": plan,
        "samples": sample_dicts,
        "summaries": summaries,
        "comparisons": comparisons,
        "observations": _observations(
            summaries,
            comparisons,
            samples,
            config.concurrency,
        ),
        "status": (
            status_override
            if status_override is not None
            else "dry-run" if dry_run else "failed" if failed else "ok"
        ),
    }


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    started = time.perf_counter()
    started_at = _utc_now()
    config: EffectiveConfig | None = None
    preflight: dict[str, Any] | None = None
    plan: dict[str, Any] | None = None
    samples: list[Sample] = []
    handshakes: dict[str, float] = {}
    try:
        config = _effective_config(args)
        cases = _load_cases(args, config)
        plan = _plan(config, cases)
        _validate_output_destination(args.output, force=args.force)
        print(
            f"{BENCHMARK_NAME}: env_file={config.env_file or 'none'} "
            f"quota_consuming_calls={plan['quota_consuming_calls']}",
            file=sys.stderr,
        )
        print(
            "warning: benchmark requests consume authenticated model quota",
            file=sys.stderr,
        )
        if config.target in {"api", "compare"} and not _base_url_is_loopback(
            config.base_url
        ):
            print(
                "warning: API benchmark source text will leave this machine",
                file=sys.stderr,
            )
        preflight = _preflight(args, config, cases)
        if not args.dry_run:
            asyncio.run(
                _execute(
                    args,
                    config,
                    cases,
                    preflight,
                    samples,
                    handshakes,
                )
            )
        report = _build_report(
            args=args,
            config=config,
            preflight=preflight,
            plan=plan,
            started_at=started_at,
            started=started,
            samples=samples,
            handshakes=handshakes,
            dry_run=args.dry_run,
        )
        rendered = _render(report, args.format)
        if args.output:
            _write_output(args.output, rendered, force=args.force)
            print(f"report written: {Path(args.output).expanduser()}", file=sys.stderr)
        else:
            sys.stdout.write(rendered)
        return 1 if any(not sample.success for sample in samples) else 0
    except KeyboardInterrupt:
        if (
            args.output
            and config is not None
            and preflight is not None
            and plan is not None
        ):
            report = _build_report(
                args=args,
                config=config,
                preflight=preflight,
                plan=plan,
                started_at=started_at,
                started=started,
                samples=samples,
                handshakes=handshakes,
                dry_run=False,
                status_override="interrupted",
            )
            try:
                _write_output(
                    args.output,
                    _render(report, args.format),
                    force=args.force,
                )
            except BenchmarkError as exc:
                print(
                    f"immerse-bench could not write partial report: {exc}",
                    file=sys.stderr,
                )
        print("immerse-bench interrupted", file=sys.stderr)
        return 130
    except BenchmarkError as exc:
        print(f"immerse-bench failed: {exc}", file=sys.stderr)
        return exc.exit_code
    except (OSError, ValueError) as exc:
        print(f"immerse-bench failed: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
