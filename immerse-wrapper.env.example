ADAPTER_HOST=127.0.0.1
ADAPTER_PORT=11435
ALLOW_NON_LOOPBACK_BIND=false

DEFAULT_BACKEND=antigravity
BACKEND_MODE=cli
MAX_CONCURRENCY=3
REQUEST_TIMEOUT_SECONDS=120
CLI_TERMINATE_GRACE_SECONDS=5
MAX_REQUEST_BYTES=1048576
MAX_PROMPT_CHARS=100000
MAX_CLI_STDOUT_BYTES=1048576
MAX_CLI_STDERR_BYTES=262144

LOG_LEVEL=INFO
# Enables DEBUG events without enabling request or response body previews.
LOG_VERBOSE=true
DEBUG_PROTOCOL=false
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false
# Phase 6.1A emits hashes, roles, and character counts without prompt text.
OBSERVE_REQUEST_SHAPE=false
LOG_BODY_MAX_CHARS=2000
LOG_FORMAT=json
# LOG_VERBOSE=true automatically creates logs/YYYYMMDD-HHMMSS.log at startup.
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

ENABLE_ANTIGRAVITY=true
ANTIGRAVITY_COMMAND=agy
ANTIGRAVITY_MODEL=gemini-3.5-flash-low
# Optional low|medium|high. Leave empty when the model slug already ends in the effort.
ANTIGRAVITY_REASONING_EFFORT=
ANTIGRAVITY_SANDBOX=true
ANTIGRAVITY_MODE=plan
ANTIGRAVITY_PRINT_TIMEOUT_SECONDS=120

ENABLE_CODEX=true
CODEX_COMMAND=codex
CODEX_MODEL=gpt-5.4-mini
# Keep the model ID separate; for example, use gpt-5.4-mini with low effort.
CODEX_REASONING_EFFORT=low
CODEX_SANDBOX=read-only
CODEX_EPHEMERAL=true
# Phase 6.2A is opt-in; exec remains the verified default.
CODEX_TRANSPORT=exec
CODEX_APP_SERVER_START_TIMEOUT_SECONDS=10
CODEX_APP_SERVER_FALLBACK_TO_EXEC=true

ENABLE_LEGACY_GEMINI=false
LEGACY_GEMINI_COMMAND=gemini
LEGACY_GEMINI_MODEL=
LEGACY_GEMINI_OUTPUT_MODE=json

ENABLE_API_CHAT=true
ENABLE_API_GENERATE=true
ENABLE_API_TAGS=true
ENABLE_API_VERSION=true
ENABLE_OPENAI_COMPAT=true
ENABLE_CORS=false
CORS_ALLOW_ORIGINS=[]

DEFAULT_STREAM_MODE=true
EMULATED_STREAM_CHUNK_SIZE=0
EMULATED_STREAM_CHUNK_DELAY_MS=0
# Phase 3 uses an in-process backend and never invokes a CLI.
MOCK_TRANSLATION_TEXT=翻譯結果

# Micro-batching is enabled for the current Antigravity browser profile.
ENABLE_MICRO_BATCHING=true
BATCH_WINDOW_MS=300
BATCH_MAX_ITEMS=6
BATCH_MAX_CHARS=20000
BATCH_MAX_PENDING=128
BATCH_FALLBACK_INDIVIDUAL=true

# Optional absolute WSL paths. Defaults are derived from the WSL user's home.
# ADAPTER_RUNTIME_DIR=/home/your-user/.local/share/immerse-wrapper
# ADAPTER_REQUEST_WORK_ROOT=/home/your-user/.cache/immerse-wrapper/requests
# ADAPTER_STATE_DIR=/home/your-user/.local/state/immerse-wrapper
